        "config": {
          "argv": null,
          "shell": null,
          "network": "egress",
          "timeoutSec": 900,
          "allowFailure": false,
          "projectCommand": "install"
        }
      },
      {
        "id": "build",
        "type": "COMMAND",
        "position": {
          "x": 640,
          "y": 160
        },
        "name": "Production build",
        "enabled": true,
        "config": {
          "argv": null,
          "shell": null,
          "network": "none",
          "timeoutSec": 900,
          "allowFailure": false,
          "projectCommand": "build"
        }
      },
      {
