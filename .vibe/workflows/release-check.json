      {
        "id": "e-build-tests",
        "source": "build",
        "sourceHandle": null,
        "target": "tests",
        "targetHandle": null,
        "condition": "always"
      },
      {
        "id": "e-tests-run",
        "source": "tests",
        "sourceHandle": null,
        "target": "run",
        "targetHandle": null,
